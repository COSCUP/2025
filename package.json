{
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "imports": {
    "#*": "./*"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "postinstall": "openapi-ts",
    "dev": "env-cmd -- vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc"
  },
  "dependencies": {
    "@iconify-json/fa-brands": "1.2.2",
    "@iconify-json/ph": "1.2.2",
    "@vueuse/core": "13.9.0",
    "calendar-link": "2.11.0",
    "leaflet": "1.9.4",
    "lightningcss": "1.32.0",
    "markdown-it": "14.1.0",
    "markdown-it-container": "4.0.0",
    "medium-zoom": "1.1.0",
    "osmtogeojson": "3.0.0-beta.5",
    "reka-ui": "2.9.6",
    "unplugin-icons": "22.5.0",
    "unplugin-vue-components": "29.2.0",
    "vitepress": "2.0.0-alpha.17",
    "vue": "3.5.33",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.4.1",
    "@hey-api/openapi-ts": "0.77.0",
    "@types/leaflet": "1.9.21",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.19.17",
    "env-cmd": "11.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-format": "1.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vue-tsc": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "vue-demi",
      "unrs-resolver",
      "esbuild"
    ]
  },
  "lint-staged": {
    "*": "eslint --no-warn-ignored --fix"
  }
}
